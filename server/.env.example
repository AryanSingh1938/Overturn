# =================================================================================================
# OVERTURN CIVIC ENGINE — SERVER ENVIRONMENT CONFIGURATION
# =================================================================================================
# Copy this file to .env (either in the project root or inside server/.env):
#   cp server/.env.example server/.env
# =================================================================================================

# Server Port & Environment
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Default: connects to local MongoDB, or replace with your MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/overturn

# Google Gemini AI Configuration (for Multimodal OCR & Precedent Embeddings)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.8-flash
GEMINI_FALLBACK_MODEL_ID=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL_ID=text-embedding-004
GEMINI_FALLBACK_EMBEDDING_MODEL_ID=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
SIMILARITY_THRESHOLD=0.70

# Security & Authentication (JWT Secret for user login sessions)
JWT_SECRET=e749ea4ea43190a524ba65d62ef995ee

# Outbound Email Dispatch Configuration (SMTP)
# In demo mode, notices are safely logged to sandbox to comply with AGENT.md Rule 5
DEMO_DISPATCH_EMAIL=demo-sandbox@overturn-justice.internal
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
