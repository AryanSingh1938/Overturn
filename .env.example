# Overturn Environment Configuration Template

# Server Configuration
PORT=5000
NODE_ENV=development

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/overturn?retryWrites=true&w=majority

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_ID=gemini-2.5-flash
GEMINI_FALLBACK_MODEL_ID=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL_ID=text-embedding-004
GEMINI_FALLBACK_EMBEDDING_MODEL_ID=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
SIMILARITY_THRESHOLD=0.72

# Outbound Dispatch & SMTP Service (Human-Confirmed Sandbox)
DEMO_DISPATCH_EMAIL=team-sandbox@overturn-justice.internal
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

